# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
ENV=local   # local | dev | prod
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug   # debug | info | warn | error

# Grafana Cloud Loki — leave empty to disable (local dev)
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://community:community@localhost:5432/community?sslmode=disable

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DRIVER=minio   # minio | s3

# MinIO (local dev)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=community
MINIO_SECRET_KEY=community
MINIO_BUCKET=community-assets

# AWS S3 / Cloudflare R2 (dev / prod — leave empty locally)
# For AWS: leave S3_ENDPOINT unset (defaults to s3.amazonaws.com) and set AWS_REGION.
# For R2:  S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com, AWS_REGION=auto
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=

# Shared secret that gates the /debug admin endpoints. Empty = admin
# disabled entirely. Set the SAME value on the frontend service.
ADMIN_SECRET=
